{
  "name": "budines",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PWA privada para registrar operaciones compartidas de Budines.",
  "scripts": {
    "dev": "wrangler pages dev public --port 8788",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "node scripts/check-syntax.mjs && node scripts/audit-project.mjs && node scripts/verify-branding.mjs",
    "check": "npm run lint",
    "validate": "npm run lint && npm run test",
    "db:migrate:local": "wrangler d1 migrations apply budines --local",
    "db:migrate:remote": "wrangler d1 migrations apply budines --remote",
    "icons": "node scripts/generate-icons.mjs",
    "deploy": "wrangler pages deploy public --project-name budines"
  },
  "devDependencies": {
    "happy-dom": "^20.10.6",
    "sharp": "^0.35.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.24.3"
  }
}
